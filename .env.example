# Réglages du POSTE DE DÉVELOPPEMENT (`npm run dev`). Ce fichier n'est pas
# versionné une fois copié en `.env` : la mise en production se règle dans
# `.env.production`, lui versionné.

# URL de l'API publique (voir ../api). Doit se terminer par /api.
# En production, `/api` (chemin relatif) est le défaut.
VITE_API_URL=http://localhost:8000/api

# Mesure d'audience Google Analytics (vide en développement, pour ne pas
# fausser les statistiques). La valeur de production est dans `.env.production`.
VITE_GA_ID=
